# Copy this file to .env and fill in your key(s):
#   cp .env.example .env
#
# GitCrawl loads .env automatically on import (see src/gitcrawl/__init__.py).
# Never commit the real .env — it's already in .gitignore.
#
# Only the key for config.toml's [models].provider is actually required.
# Currently that's "google" (Gemini) — GOOGLE_API_KEY from
# aistudio.google.com, no card needed. See config.toml's note for why
# (Mistral and Groq were both tried first and hit real limitations).

MISTRAL_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# GitHub API access (issues, pull requests, contributors, releases, CI runs).
# Free and read-only is enough: GitHub -> Settings -> Developer settings -> Personal access
# tokens -> Fine-grained tokens, Repository access: Public repositories. GH_TOKEN also works.
GITHUB_TOKEN=
